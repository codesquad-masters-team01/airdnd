VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_OAUTH_BASE_URL=http://127.0.0.1:8080
VITE_ENABLE_MOCKS=false

# 목 모드(VITE_ENABLE_MOCKS=true)에서 초기 로그인 역할을 지정합니다: GUEST | HOST | ADMIN
# 예) GUEST 로 설정하면 "호스팅 시작하기" 승격 플로우를 목 모드에서 그대로 테스트할 수 있습니다.
# 미설정 시 비로그인 상태입니다.
# VITE_MOCK_ROLE=GUEST

# Google Maps (브라우저 키 - 반드시 referrer 및 API 제한을 설정하세요)
# 값은 루트 .env의 GOOGLE_MAPS_API_KEY / GOOGLE_MAP_ID 에서 복사합니다.
VITE_GOOGLE_MAPS_API_KEY=
# Advanced Marker 사용에 필요. 개발 초기에는 DEMO_MAP_ID 도 가능합니다.
VITE_GOOGLE_MAPS_MAP_ID=
